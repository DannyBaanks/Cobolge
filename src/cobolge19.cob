*> cobolge19.cob - Malbolge Unshackled (3^19), GnuCOBOL.
*> Unshackled memory uses a 3^19 address space and the 141-character table.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. cobolge19.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 CON.
          05 ENDV     PIC 9(18) COMP-5 VALUE 1162261467.
          05 THIRD    PIC 9(18) COMP-5 VALUE 387420489.
          05 PAGESZ   PIC 9(18) COMP-5 VALUE 65536.
          05 MAX-OUT  PIC 9(18) COMP-5 VALUE 65536.
       01 CRZ2-RAW PIC X(144) VALUE
          "433100100999999943510210299999995542212219999999433100766999999943510276899999995542218879999999766766433999999976876843599999998878875549999999".
       01 CRZ3-RAW PIC X(9) VALUE "100102221".
       01 TI2 PIC 9(18) COMP-5 VALUE 0.
       01 MEM.
          05 ICNT PIC 9(18) COMP-5 VALUE 0.
          05 IPR PIC X(4194304).
          05 ITB PIC 9(6) COMP-5 OCCURS 4194304 TIMES.
          05 ZS PIC 9(18) COMP-5 VALUE 0.
          05 ZT PIC 9(18) COMP-5 OCCURS 65536 TIMES.
          05 PT PIC 9(18) COMP-5 OCCURS 6 TIMES.
          05 OC PIC 9(9) COMP-5 VALUE 0.
          05 OK PIC 9(18) COMP-5 OCCURS 65536 TIMES.
          05 OV PIC 9(18) COMP-5 OCCURS 65536 TIMES.
       01 XLAT-STR PIC X(141) VALUE X"534f4d45424f4459204d414b45204d45204645454c20414c4956455b686a393e2c357a5d2667717479667224287765347b575029482d5a6e2c5b255c33644c2b513b3e5521704a53373246684f4131434236765e3d495f302f387c6a7362396d3c2e545661636075592a4d4b27587e78446c7d52456f6b4e3a233f47226940414e442053484154544552204d45".
       01 VM.
          05 AR PIC 9(18) COMP-5 VALUE 0.
          05 RG PIC 9(18) COMP-5 VALUE 0.
          05 DRM PIC 9(18) COMP-5 VALUE 0.
          05 ST PIC 9(18) COMP-5 VALUE 0.
          05 MS PIC 9(18) COMP-5 VALUE 100000000.
          05 HT PIC X VALUE 'N'.
          05 OL PIC 9(9) COMP-5 VALUE 0.
          05 OD PIC X(65536).
       01 T.
          05 TA PIC 9(18) COMP-5 VALUE 0.
          05 TB PIC 9(18) COMP-5 VALUE 0.
          05 TC PIC 9(18) COMP-5 VALUE 0.
          05 TD PIC 9(18) COMP-5 VALUE 0.
          05 T1V PIC 9(18) COMP-5 VALUE 0.
          05 T2V PIC 9(18) COMP-5 VALUE 0.
          05 M9 PIC 9(18) COMP-5 VALUE 0.
          05 N9 PIC 9(18) COMP-5 VALUE 0.
          05 TM PIC 9(18) COMP-5 VALUE 0.
          05 TQ PIC 9(18) COMP-5 VALUE 0.
          05 TK PIC 9(18) COMP-5 VALUE 0.
          05 FIDX PIC 9(18) COMP-5 VALUE 0.
          05 RGN PIC 9(18) COMP-5 VALUE 0.
          05 PBX PIC 9(18) COMP-5 VALUE 0.
          05 PHS PIC 9(18) COMP-5 VALUE 0.
          05 PR1 PIC 9(18) COMP-5 VALUE 0.
          05 PR2 PIC 9(18) COMP-5 VALUE 0.
          05 OFFS PIC 9(18) COMP-5 OCCURS 3 TIMES.
       01 CLI.
          05 ARGN PIC 9(6) COMP-5.
          05 ARGSTR PIC X(1024).
          05 PRG PIC X(1024).
          05 JSN PIC X VALUE 'N'.
       01 REP.
          05 RP PIC X(512).
          05 RPJ PIC 9(9) COMP-5 VALUE 1.
          05 NIN PIC 9(18) COMP-5.
          05 NOUT PIC X(21).
          05 NOL PIC 9(18) COMP-5.
          05 NTMP PIC 9(18) COMP-5.
          05 NREM PIC 9(18) COMP-5.
          05 NDIG PIC 9(18) OCCURS 21 TIMES.
          05 NDN PIC 9(18) COMP-5.
       PROCEDURE DIVISION.
       MAIN.
           CALL "cobinit"
           ACCEPT ARGN FROM ARGUMENT-NUMBER
           IF ARGN < 1
              DISPLAY "usage: cobolge19 <image.mal> [max_steps] [--json]"
                 UPON STDERR
              STOP RUN RETURNING 1
           END-IF
           PERFORM PARSE-CLI
           PERFORM LOAD-IMG
           PERFORM BUILD-OFFS
           PERFORM INIT-ZONE
           PERFORM RUNLOOP
           PERFORM EMIT-OUT
           PERFORM EMIT-RPT
           STOP RUN.
       PARSE-CLI.
           PERFORM VARYING TA FROM 1 BY 1 UNTIL TA > ARGN
              MOVE SPACES TO ARGSTR
              ACCEPT ARGSTR FROM ARGUMENT-VALUE
              IF ARGSTR(1:2) = "--"
                 IF FUNCTION TRIM(ARGSTR) = "--json"
                    MOVE 'Y' TO JSN
                 END-IF
              ELSE IF FUNCTION TRIM(PRG) = SPACES
                 MOVE FUNCTION TRIM(ARGSTR) TO PRG
              ELSE
                 COMPUTE MS = FUNCTION NUMVAL(ARGSTR)
              END-IF
           END-PERFORM
           IF FUNCTION TRIM(PRG) = SPACES
              DISPLAY "error: missing image" UPON STDERR
              STOP RUN RETURNING 1
           END-IF.
       LOAD-IMG.
           MOVE SPACES TO IPR
           CALL "cobfread" USING BY REFERENCE PRG
              BY VALUE FUNCTION LENGTH(FUNCTION TRIM(PRG))
              BY REFERENCE IPR BY VALUE 4194304 RETURNING TA
           IF TA < 1
              DISPLAY "error: cannot read " FUNCTION TRIM(PRG)
                 UPON STDERR
              STOP RUN RETURNING 2
           END-IF
           MOVE TA TO ICNT
           PERFORM VARYING TA FROM 1 BY 1 UNTIL TA > ICNT
              COMPUTE ITB(TA) = FUNCTION ORD(IPR(TA:1)) - 1
           END-PERFORM.
       BUILD-OFFS.
           MOVE 0 TO OFFS(1)
           COMPUTE T1V = 94 - FUNCTION MOD((ENDV - 1) / 6 - 29524, 94)
           COMPUTE OFFS(2) = FUNCTION MOD(T1V - THIRD, 94) + 94
           COMPUTE T1V = 94 - FUNCTION MOD((ENDV - 1) / 3 - 59048, 94)
           COMPUTE OFFS(3) = T1V - FUNCTION MOD(2 * THIRD, 94) + 94.
       INIT-ZONE.
           COMPUTE TA = FUNCTION INTEGER((ICNT + PAGESZ - 1) / PAGESZ)
           COMPUTE ZS = TA * PAGESZ
           IF ZS - ICNT > 65536 COMPUTE ZS = ICNT + 65536 END-IF
           IF ICNT >= 2
              MOVE ITB(ICNT - 1) TO PR2
              MOVE ITB(ICNT) TO PR1
           ELSE
              MOVE 0 TO PR1 PR2
           END-IF
           MOVE ICNT TO TC
           PERFORM UNTIL TC >= ZS
              MOVE PR1 TO M9 MOVE PR2 TO N9
              PERFORM DO-CRZ
              MOVE TA TO ZT(TC - ICNT + 1)
              MOVE PR1 TO PR2 MOVE TA TO PR1
              ADD 1 TO TC
           END-PERFORM
           PERFORM VARYING TC FROM 1 BY 1 UNTIL TC > 6
              MOVE PR1 TO M9 MOVE PR2 TO N9
              PERFORM DO-CRZ
              MOVE TA TO PT(TC)
              MOVE PR1 TO PR2 MOVE TA TO PR1
           END-PERFORM.
       DO-CRZ.
           MOVE 0 TO TA MOVE 1 TO TK
           PERFORM VARYING TI2 FROM 1 BY 1 UNTIL TI2 > 9
              COMPUTE T2V = FUNCTION MOD(M9, 9) + 16 * FUNCTION MOD(N9, 9) + 1
              COMPUTE TA = TA + TK * (FUNCTION ORD(CRZ2-RAW(T2V:1)) - 49)
              COMPUTE TA = FUNCTION MOD(TA, 4294967296)
              COMPUTE M9 = M9 / 9 COMPUTE N9 = N9 / 9 COMPUTE TK = TK * 9
           END-PERFORM
           COMPUTE T2V = FUNCTION MOD(N9, 3) * 3 + FUNCTION MOD(M9, 3) + 1
           COMPUTE TA = TA + TK * (FUNCTION ORD(CRZ3-RAW(T2V:1)) - 49)
           COMPUTE TA = FUNCTION MOD(TA, 4294967296).
       DO-ROT.
           COMPUTE TB = FUNCTION MOD(T1V, THIRD)
           COMPUTE TM = FUNCTION MOD(TB, 3)
           COMPUTE TQ = TB / 3
           COMPUTE T1V = TQ + TM * (THIRD / 3) + (T1V - TB)
           COMPUTE T1V = FUNCTION MOD(T1V, 4294967296).
       MEM-GET.
           IF TC < ICNT MOVE ITB(TC + 1) TO T2V EXIT PARAGRAPH END-IF
           PERFORM OV-FIND
           IF FIDX > 0 MOVE OV(FIDX) TO T2V EXIT PARAGRAPH END-IF
           IF TC < ZS MOVE ZT(TC - ICNT + 1) TO T2V EXIT PARAGRAPH END-IF
           COMPUTE PBX = TC - FUNCTION MOD(TC, PAGESZ)
           COMPUTE PHS = FUNCTION MOD(FUNCTION MOD(PBX, THIRD) + TC - PBX, 6)
           MOVE PT(PHS + 1) TO T2V.
       OV-FIND.
           MOVE 0 TO FIDX
           PERFORM VARYING FIDX FROM 1 BY 1 UNTIL FIDX > OC
              IF OK(FIDX) = TC EXIT PARAGRAPH END-IF
           END-PERFORM
           MOVE 0 TO FIDX.
       MEM-SET.
           IF TC < ICNT MOVE T2V TO ITB(TC + 1) EXIT PARAGRAPH END-IF
           PERFORM VARYING FIDX FROM 1 BY 1 UNTIL FIDX > OC
              IF OK(FIDX) = TC MOVE T2V TO OV(FIDX) EXIT PARAGRAPH END-IF
           END-PERFORM
           ADD 1 TO OC MOVE TC TO OK(OC) MOVE T2V TO OV(OC).
       RUNLOOP.
           PERFORM UNTIL HT = 'Y' OR ST >= MS
              PERFORM STEP ADD 1 TO ST
           END-PERFORM.
       STEP.
           MOVE RG TO TC PERFORM MEM-GET
           COMPUTE RGN = RG / THIRD
           IF RGN >= 3 MOVE 0 TO TA
           ELSE ADD 1 TO RGN MOVE OFFS(RGN) TO TA END-IF
           COMPUTE FIDX = FUNCTION MOD(RG + T2V + TA, 94)
           EVALUATE FIDX
              WHEN 4 MOVE DRM TO TC PERFORM MEM-GET MOVE T2V TO RG
              WHEN 5 IF OL < MAX-OUT ADD 1 TO OL
                 COMPUTE TD = FUNCTION MOD(AR, 256) + 1
                 MOVE FUNCTION CHAR(TD) TO OD(OL:1) END-IF
              WHEN 23 CALL "cobgetc" RETURNING T1V
                 IF T1V < 0 COMPUTE AR = FUNCTION MOD(ENDV - 1, 4294967296)
                 ELSE MOVE T1V TO AR END-IF
              WHEN 39 MOVE DRM TO TC PERFORM MEM-GET MOVE T2V TO T1V
                 PERFORM DO-ROT MOVE DRM TO TC MOVE T1V TO T2V
                 PERFORM MEM-SET MOVE T1V TO AR
              WHEN 40 MOVE DRM TO TC PERFORM MEM-GET MOVE T2V TO DRM
              WHEN 62 MOVE DRM TO TC PERFORM MEM-GET MOVE AR TO M9
                 MOVE T2V TO N9 PERFORM DO-CRZ MOVE DRM TO TC
                 MOVE TA TO T2V PERFORM MEM-SET MOVE TA TO AR
              WHEN 81 MOVE 'Y' TO HT EXIT PARAGRAPH
              WHEN OTHER CONTINUE
           END-EVALUATE
           MOVE RG TO TC PERFORM MEM-GET
           IF T2V < 141 COMPUTE FIDX = T2V + 1
              COMPUTE T2V = FUNCTION ORD(XLAT-STR(FIDX:1)) - 1
              MOVE RG TO TC PERFORM MEM-SET END-IF
           COMPUTE RG = FUNCTION MOD(RG + 1, ENDV)
           COMPUTE DRM = FUNCTION MOD(DRM + 1, ENDV).
       EMIT-OUT.
           PERFORM VARYING TC FROM 1 BY 1 UNTIL TC > OL
              CALL "cobputc" USING BY VALUE FUNCTION ORD(OD(TC:1))
           END-PERFORM
           CALL "cobflush".
       EMIT-RPT.
           MOVE 1 TO RPJ
           STRING "{""final"":{""a"":" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           MOVE AR TO NIN PERFORM N2S
           STRING NOUT(1:NOL) DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           STRING ",""c"":" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           MOVE RG TO NIN PERFORM N2S
           STRING NOUT(1:NOL) DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           STRING ",""d"":" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           MOVE DRM TO NIN PERFORM N2S
           STRING NOUT(1:NOL) DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           STRING ",""halt_reason"":""" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           IF HT = 'Y' STRING "VInstruction" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           ELSE STRING "StepsExhausted" DELIMITED BY SIZE INTO RP WITH POINTER RPJ END-IF
           STRING """,""output_len"":" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           MOVE OL TO NIN PERFORM N2S
           STRING NOUT(1:NOL) DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           STRING ",""status"":""" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           IF HT = 'Y' STRING "HALTED" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           ELSE STRING "TIMEOUT" DELIMITED BY SIZE INTO RP WITH POINTER RPJ END-IF
           STRING """,""steps"":" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           MOVE ST TO NIN PERFORM N2S
           STRING NOUT(1:NOL) DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           STRING "}" DELIMITED BY SIZE INTO RP WITH POINTER RPJ
           CALL "cobwerr" USING BY REFERENCE RP BY VALUE RPJ
           CALL "cobpterr" USING BY VALUE 10.
       N2S.
           IF NIN = 0 MOVE "0" TO NOUT MOVE 1 TO NOL EXIT PARAGRAPH END-IF
           MOVE NIN TO NTMP MOVE 0 TO NDN
           PERFORM UNTIL NTMP = 0
              ADD 1 TO NDN COMPUTE NDIG(NDN) = FUNCTION MOD(NTMP, 10)
              COMPUTE NTMP = NTMP / 10
           END-PERFORM
           MOVE SPACES TO NOUT
           PERFORM VARYING TD FROM 1 BY 1 UNTIL TD > NDN
              COMPUTE T2V = NDIG(NDN + 1 - TD) + 49
              MOVE FUNCTION CHAR(T2V) TO NOUT(TD:1)
           END-PERFORM
           MOVE NDN TO NOL.
       END PROGRAM cobolge19.
